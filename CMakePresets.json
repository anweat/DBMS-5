{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msys2-ucrt64",
      "displayName": "Windows MSYS2 UCRT64 Ninja",
      "description": "Use a small wrapper so MSYS2 g++ receives forward-slash paths from CMake/Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "environment": {
        "PATH": "C:\\msys64\\ucrt64\\bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "${sourceDir}/tools/mingw-gpp-wrapper.cmd"
      }
    },
    {
      "name": "windows-msys2-ucrt64-qt",
      "displayName": "Windows MSYS2 UCRT64 Qt6 Ninja",
      "description": "Build the optional Qt Widgets frontend with the MSYS2 UCRT64 Qt6 package.",
      "inherits": "windows-msys2-ucrt64",
      "binaryDir": "${sourceDir}/build-qt-msys",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "${sourceDir}/tools/mingw-gpp-wrapper.cmd",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "DBMS_BUILD_QT": "ON",
        "DBMS_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "macos-qt-debug",
      "displayName": "macOS Qt6 Debug",
      "description": "Build Qt frontend with official Qt installer on macOS.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-qt-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "/Users/watuji/Qt/6.11.1/macos",
        "DBMS_BUILD_QT": "ON",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msys2-ucrt64",
      "configurePreset": "windows-msys2-ucrt64"
    },
    {
      "name": "windows-msys2-ucrt64-qt",
      "configurePreset": "windows-msys2-ucrt64-qt",
      "targets": ["dbms_qt"]
    },
    {
      "name": "macos-qt-debug",
      "configurePreset": "macos-qt-debug",
      "targets": ["dbms_qt"]
    }
  ],
  "testPresets": [
    {
      "name": "windows-msys2-ucrt64",
      "configurePreset": "windows-msys2-ucrt64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
